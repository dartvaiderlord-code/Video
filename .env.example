# Standalone HTTPS: use your server hostname or IPv4, no scheme/path/port here.
DOMAIN=screen.example.com
PUBLIC_ORIGIN=https://screen.example.com:8443
HTTPS_PORT=8443
APP_PORT=3100
# Abordage native media: expose this UDP port (separate from HTTPS and TURN).
ABORDAGE_PORT=3480
# Optional public media host when HTTPS resolves through a CDN/proxy:
ABORDAGE_HOST=
MAX_VIEWERS=6
# Room codes are chosen in the browser, not in this file.
# Generate TURN_SECRET with openssl rand -hex 32.
TURN_SECRET=
TURN_PUBLIC_IP=
TURN_PORT=3479
TURN_MIN_PORT=40000
TURN_MAX_PORT=40060
# Replace PUBLIC_IPV4 with the actual server address, or leave empty without TURN.
TURN_URLS=turn:PUBLIC_IPV4:3479?transport=udp,turn:PUBLIC_IPV4:3479?transport=tcp
